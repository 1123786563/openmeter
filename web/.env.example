# API base path used by src/lib/api.ts (the Vite dev server proxies /api to
# the OpenMeter backend, so this rarely needs changing).
VITE_API_BASE=/api

# Casdoor OIDC (authorization code + PKCE).
# VITE_CASDOOR_ISSUER is the Casdoor endpoint, e.g. https://casdoor.example.com
VITE_CASDOOR_ISSUER=
VITE_CASDOOR_CLIENT_ID=

# Redirect URIs default to the current origin:
#   {origin}/auth/callback and {origin}/sign-in
# Only set them explicitly when the app runs behind a different public origin
# than the one the browser sees. Register the actual URIs in the Casdoor
# application (dev server may land on 5174/5175 when 5173 is taken).
# VITE_CASDOOR_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_CASDOOR_LOGOUT_REDIRECT_URI=http://localhost:5173/sign-in
