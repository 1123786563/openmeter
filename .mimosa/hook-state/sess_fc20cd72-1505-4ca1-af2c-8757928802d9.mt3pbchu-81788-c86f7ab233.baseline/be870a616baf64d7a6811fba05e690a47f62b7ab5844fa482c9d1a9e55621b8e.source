// HasAccount applies the HasEdge predicate on the "account" edge.
func HasAccount() predicate.OfflinePayment {
	return predicate.OfflinePayment(func(s *sql.Selector) {
		step := sqlgraph.NewStep(
			sqlgraph.From(Table, FieldID),
			sqlgraph.Edge(sqlgraph.M2O, true, AccountTable, AccountColumn),
		)
		sqlgraph.HasNeighbors(s, step)
	})
}

// HasAccountWith applies the HasEdge predicate on the "account" edge with a given conditions (other predicates).
func HasAccountWith(preds ...predicate.ReceivableAccount) predicate.OfflinePayment {
	return predicate.OfflinePayment(func(s *sql.Selector) {
		step := newAccountStep()
		sqlgraph.HasNeighborsWith(s, step, func(s *sql.Selector) {
			for _, p := range preds {
				p(s)
			}
		})
	})
}

// And groups predicates with the AND operator between them.
func And(predicates ...predicate.OfflinePayment) predicate.OfflinePayment {
	return predicate.OfflinePayment(sql.AndPredicates(predicates...))
}

// Or groups predicates with the OR operator between them.
func Or(predicates ...predicate.OfflinePayment) predicate.OfflinePayment {
	return predicate.OfflinePayment(sql.OrPredicates(predicates...))
}

// Not applies the not operator on the given predicate.
func Not(p predicate.OfflinePayment) predicate.OfflinePayment {
	return predicate.OfflinePayment(sql.NotPredicates(p))
}
