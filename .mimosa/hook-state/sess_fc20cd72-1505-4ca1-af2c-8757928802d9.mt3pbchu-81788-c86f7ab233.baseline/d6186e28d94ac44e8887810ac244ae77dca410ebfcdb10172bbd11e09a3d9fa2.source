// HasAttempt applies the HasEdge predicate on the "attempt" edge.
func HasAttempt() predicate.PaymentFact {
	return predicate.PaymentFact(func(s *sql.Selector) {
		step := sqlgraph.NewStep(
			sqlgraph.From(Table, FieldID),
			sqlgraph.Edge(sqlgraph.M2O, true, AttemptTable, AttemptColumn),
		)
		sqlgraph.HasNeighbors(s, step)
	})
}

// HasAttemptWith applies the HasEdge predicate on the "attempt" edge with a given conditions (other predicates).
func HasAttemptWith(preds ...predicate.PaymentAttempt) predicate.PaymentFact {
	return predicate.PaymentFact(func(s *sql.Selector) {
		step := newAttemptStep()
		sqlgraph.HasNeighborsWith(s, step, func(s *sql.Selector) {
			for _, p := range preds {
				p(s)
			}
		})
	})
}

// And groups predicates with the AND operator between them.
func And(predicates ...predicate.PaymentFact) predicate.PaymentFact {
	return predicate.PaymentFact(sql.AndPredicates(predicates...))
}

// Or groups predicates with the OR operator between them.
func Or(predicates ...predicate.PaymentFact) predicate.PaymentFact {
	return predicate.PaymentFact(sql.OrPredicates(predicates...))
}

// Not applies the not operator on the given predicate.
func Not(p predicate.PaymentFact) predicate.PaymentFact {
	return predicate.PaymentFact(sql.NotPredicates(p))
}
