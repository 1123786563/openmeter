			}
			if _, exists := b.mutation.TotalCents(); exists {
				s.SetIgnore(commerceorder.FieldTotalCents)
			}
			if _, exists := b.mutation.Currency(); exists {
				s.SetIgnore(commerceorder.FieldCurrency)
			}
			if _, exists := b.mutation.IdempotencyKey(); exists {
				s.SetIgnore(commerceorder.FieldIdempotencyKey)
			}
		}
	}))
	return u
}

